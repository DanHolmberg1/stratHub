# Copy to /etc/strathub.env (chmod 600) and fill in.
STRATHUB_DEBUG=0
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
STRATHUB_SECRET_KEY=change-me
STRATHUB_ALLOWED_HOSTS=strats.example.com
STRATHUB_CSRF_TRUSTED_ORIGINS=https://strats.example.com
# Database + uploaded media live here. Back this folder up.
STRATHUB_DATA_DIR=/srv/strathub/data
# Let Caddy stream videos after Django checks permissions (see Caddyfile).
STRATHUB_MEDIA_X_ACCEL=1
STRATHUB_MAX_VIDEO_MB=250
STRATHUB_TIME_ZONE=Europe/Stockholm
